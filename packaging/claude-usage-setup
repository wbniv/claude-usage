#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    cat <<EOF
Usage: $(basename "$0") [no arguments]
Post-install setup: enables the GNOME extension, starts the systemd service,
and writes the user-level .desktop launcher for the current user.
EOF
    exit 0
fi

echo "Setting up Claude Usage for $USER..."

# 1. User-level .desktop file with dynamic icon path
mkdir -p "$HOME/.local/share/applications"
cat > "$HOME/.local/share/applications/claude-usage.desktop" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=Claude Usage
Comment=Claude.ai weekly usage meter
Exec=xdg-open https://claude.ai/settings/usage
Icon=claude-usage
StartupWMClass=claude-usage
Categories=Utility;
NoDisplay=false
EOF
update-desktop-database "$HOME/.local/share/applications/" 2>/dev/null || true
echo "  ✓ Dock entry installed"

# 2. Systemd user service
systemctl --user daemon-reload
# Clear any failed/auto-restart state from a previous broken version so the
# enable/restart pair below actually progresses the unit rather than refusing
# because StartLimitBurst was already exhausted.
systemctl --user reset-failed claude-usage-fetch.service 2>/dev/null || true
systemctl --user enable claude-usage-fetch.service
# `restart` works whether the service is running (re-execs new code) or stopped
# (equivalent to `start`). `enable --now` would be a no-op against an already-
# running unit, leaving upgraded users on stale code — the same running ≠ disk
# drift class as pass-14's V-2, one step further along the deploy pipeline.
systemctl --user restart claude-usage-fetch.service
echo "  ✓ Service enabled and (re)started"

# 3. GNOME extension — enable via D-Bus if shell knows about it, else add UUID
# directly to enabled-extensions so it auto-loads on next login (Wayland can't
# restart gnome-shell, so a freshly-installed extension is invisible to D-Bus
# until logout — without this fallback the extension stays disabled forever).
# I-2 (pass-15 §7): the success branch also needs to mention logout because
# on Wayland `gnome-extensions enable` succeeds (dconf write) but the running
# shell doesn't pick up the new code until next session — so "enabled" is
# strictly true (registered + marked-enabled) but operationally misleading.
UUID=claude-usage@indri.studio
if ! command -v gnome-extensions >/dev/null 2>&1 || ! command -v gsettings >/dev/null 2>&1; then
    # No GNOME tooling (e.g. a KDE Plasma session) — there's no extension to
    # enable; the plasmoid is added by the user via "Add Widgets". Skip cleanly
    # rather than aborting under `set -e` on the gsettings call below.
    echo "  ℹ  GNOME tools not found — skipping extension enable (KDE users add the widget via Add Widgets)"
elif gnome-extensions enable "$UUID" 2>/dev/null; then
    echo "  ✓ GNOME extension enabled (log out and back in if the panel indicator isn't visible)"
else
    current=$(gsettings get org.gnome.shell enabled-extensions)
    if ! grep -q "'$UUID'" <<<"$current"; then
        # Strip trailing ] and insert UUID; handle empty list (@as []) too
        if [[ "$current" == "@as []" || "$current" == "[]" ]]; then
            new="['$UUID']"
        else
            new="${current%]}, '$UUID']"
        fi
        gsettings set org.gnome.shell enabled-extensions "$new"
    fi
    echo "  ℹ  GNOME extension queued — log out and back in to activate the panel"
fi

# 4. Generate initial icon
python3 /usr/share/claude-usage/generate-icon.py 2>/dev/null || true

echo ""
echo "Now load the Chrome extension:"
echo "  1. Open chrome://extensions"
echo "  2. Enable Developer mode"
echo "  3. Load unpacked → /usr/share/claude-usage/chrome-extension/"
echo ""
if [[ "${XDG_CURRENT_DESKTOP:-}" == *KDE* ]]; then
    echo "Then add the widget: right-click your Plasma panel → Add Widgets → 'Claude Usage'"
else
    echo "Then: Super key → search 'Claude Usage' → right-click → Add to Favorites"
fi
