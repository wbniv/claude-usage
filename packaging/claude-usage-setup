#!/usr/bin/env bash
set -euo pipefail

echo "Setting up Claude Usage for $USER..."

# 1. User config (colors)
mkdir -p "$HOME/.config/claude-usage"
if [ ! -f "$HOME/.config/claude-usage/config.json" ]; then
    cat > "$HOME/.config/claude-usage/config.json" <<'EOF'
{
  "weekly_color_green": "#8cff8c",
  "weekly_color_amber": "#ffe033",
  "weekly_color_red":   "#ff5933",
  "sonnet_color":       "#4dbfff"
}
EOF
    echo "  ✓ Config created: $HOME/.config/claude-usage/config.json"
else
    echo "  ✓ Config already exists (not overwritten)"
fi

# 2. User-level .desktop file with dynamic icon path
mkdir -p "$HOME/.local/share/applications"
cat > "$HOME/.local/share/applications/claude-usage.desktop" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=Claude Usage
Comment=Claude.ai weekly usage meter
Exec=xdg-open https://claude.ai/settings/usage
Icon=$HOME/.cache/claude-usage-icon.png
StartupWMClass=claude-usage
Categories=Utility;
NoDisplay=false
EOF
update-desktop-database "$HOME/.local/share/applications/" 2>/dev/null || true
echo "  ✓ Dock entry installed"

# 3. Systemd user service
systemctl --user daemon-reload
systemctl --user enable --now claude-usage-fetch.service
echo "  ✓ Service enabled"

# 4. GNOME extension
gnome-extensions enable claude-usage@wbnorris.gmail.com 2>/dev/null \
    && echo "  ✓ GNOME extension enabled" \
    || echo "  ℹ  GNOME extension registered — log out and back in to activate"

# 5. Generate initial icon
python3 /usr/share/claude-usage/generate-icon.py 2>/dev/null || true

echo ""
echo "Now load the Chrome extension:"
echo "  1. Open chrome://extensions"
echo "  2. Enable Developer mode"
echo "  3. Load unpacked → /usr/share/claude-usage/chrome-extension/"
echo ""
echo "Then: Super key → search 'Claude Usage' → right-click → Add to Favorites"
