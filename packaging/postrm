#!/bin/bash
set -euo pipefail
case "$1" in
    remove|purge)
        update-desktop-database -q /usr/share/applications/ || true
        rm -f /usr/share/glib-2.0/schemas/org.indri.claude-usage.gschema.xml
        glib-compile-schemas /usr/share/glib-2.0/schemas/ 2>/dev/null || true
        ;;
esac
