#!/bin/bash
set -euo pipefail
case "$1" in
    configure)
        # Copy the GNOME schema into the system glib dir so `gsettings` works
        # without GSETTINGS_SCHEMA_DIR. Plain cp — needs no tools, so it runs on
        # KDE too (harmless there). The extension's own gschemas.compiled is
        # already shipped in the .deb (compiled at build time), so the GNOME
        # extension itself works regardless of target glib tooling.
        cp /usr/share/gnome-shell/extensions/claude-usage@indri.studio/schemas/*.xml \
            /usr/share/glib-2.0/schemas/ 2>/dev/null || true
        # Recompile the system schema cache only where glib tools exist. The
        # package no longer hard-depends on gnome-shell (Recommends alternative
        # with plasma-workspace), so a KDE-only box may lack libglib2.0-bin —
        # without this guard the unguarded call would abort dpkg --configure
        # under `set -e`.
        if command -v glib-compile-schemas >/dev/null 2>&1; then
            glib-compile-schemas /usr/share/glib-2.0/schemas/ 2>/dev/null || true
        fi
        update-desktop-database -q /usr/share/applications/ || true
        gtk-update-icon-cache -f -t /usr/share/icons/hicolor/ || true

        # Auto-run per-user setup when invoked via sudo with a live user session.
        # Falls back to printing instructions if we can't tell who/where to run.
        target_user="${SUDO_USER:-${PKEXEC_UID:+$(getent passwd "$PKEXEC_UID" | cut -d: -f1)}}"
        if [ -n "$target_user" ] && [ "$target_user" != "root" ]; then
            uid=$(id -u "$target_user" 2>/dev/null || echo "")
            runtime="/run/user/$uid"
            if [ -n "$uid" ] && [ -S "$runtime/bus" ]; then
                echo ""
                echo "Running per-user setup for $target_user..."
                runuser -u "$target_user" -- env \
                    XDG_RUNTIME_DIR="$runtime" \
                    DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" \
                    /usr/bin/claude-usage-setup || \
                    echo "  ⚠ per-user setup failed — run 'claude-usage-setup' manually"
                exit 0
            fi
        fi
        echo ""
        echo "Claude Usage installed. Activate for your user account:"
        echo ""
        echo "    claude-usage-setup"
        echo ""
        ;;
esac
