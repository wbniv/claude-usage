+  const A = SECTION_ANCHORS;
   const lines = textContent.split('\n').map(l => l.trim()).filter(l => l.length > 0);
   ...
-  const planStart = lines.findIndex(l => l === 'Plan usage limits');
+  const planStart = lines.findIndex(l => l === A.PLAN);
   ...
-  const extraStart = lines.findIndex(l => l === 'Extra usage');
+  const extraStart = lines.findIndex(l => l === A.EXTRA);
